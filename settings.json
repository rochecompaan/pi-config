{
  "lastChangelogVersion": "0.64.0",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "contextPaging": {
    "enabled": true,
    "tokenBudget": 200000,
    "trimToTokens": 140000
  },
  "handoff": {
    "autoThresholdTokens": 150000
  },
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low"
      },
      "oracle": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium",
        "defaultContext": "fresh"
      }
    }
  },
  "theme": "stylix",
  "tuiMode": "regular",
  "outputPad": 0
}
