+function bootstrapSkillEnabled(systemPrompt: string, cwd: string): boolean {
+	// Find Pi's last exact cwd section, not a cwd tag quoted in instructions.
+	// Only its immediately preceding skills section advertises active skills.
+	const cwdSection = `\n\n<cwd>\n${cwd.replace(/\\/g, "/")}\n</cwd>`;
+	const cwdBoundary = systemPrompt.lastIndexOf(cwdSection);
+	if (cwdBoundary === -1) return false;
+	const beforeCwd = systemPrompt.slice(0, cwdBoundary);
+	const skillsStart = beforeCwd.lastIndexOf("\n\n<skills>\n");
+	if (skillsStart === -1 || !beforeCwd.endsWith("\n</skills>")) return false;
+	const skillsSection = beforeCwd.slice(skillsStart);
+	const skillsBlock = skillsSection.match(/<available_skills>[\s\S]*?<\/available_skills>/)?.[0];
+	return !!skillsBlock && /<name>\s*using-superpowers\s*<\/name>/.test(skillsBlock);
+}
