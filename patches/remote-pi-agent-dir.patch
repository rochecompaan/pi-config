diff --git a/dist/remote_home.js b/dist/remote_home.js
new file mode 100644
index 0000000..334f857
--- /dev/null
+++ b/dist/remote_home.js
@@ -0,0 +1,14 @@
+import { homedir } from "node:os";
+import { join } from "node:path";
+/**
+ * Home directory under which remote-pi keeps `.pi/remote` and `.pi/remote-pi`.
+ * A launcher whose Pi cannot write to HOME, such as a sandbox, sets
+ * `REMOTE_PI_HOME_FROM_AGENT_DIR=1` to keep a private mesh in Pi's agent
+ * directory instead. `REMOTE_PI_HOME` still wins where remote-pi honors it.
+ */
+export function remoteHome() {
+    const agentDir = process.env["PI_CODING_AGENT_DIR"]?.trim();
+    if (process.env["REMOTE_PI_HOME_FROM_AGENT_DIR"] === "1" && agentDir)
+        return join(agentDir, "remote-pi");
+    return homedir();
+}
